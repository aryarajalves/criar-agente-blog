# [OBRIGATÓRIO] URL de Conexão com o Banco de Dados PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# [OBRIGATÓRIO] Chave Secreta para Geração e Validação de Tokens JWT
JWT_SECRET=sua_chave_secreta_jwt_aqui

# [OPCIONAL] Nome do usuário administrador inicial criado no seed
ADMIN_USERNAME=admin

# [OBRIGATÓRIO] E-mail do usuário administrador inicial (usado para login)
ADMIN_EMAIL=admin@example.com

# [OBRIGATÓRIO] Senha do usuário administrador inicial
ADMIN_PASSWORD=senha_segura_123

# [OBRIGATÓRIO] Chave de API da OpenAI para gerar conteúdo de blog com IA (GPT)
OPENAI_API_KEY=sk-sua-chave-openai-aqui
